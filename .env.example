# Connection settings for the local lab database and the app. Throwaway values for a container
# that only listens on your own machine; copy to .env to change them.
PGHOST=localhost
PGPORT=55432
PGUSER=lab
PGPASSWORD=lab
PGDATABASE=lab

# The listing app (make serve, make run).
APP_PORT=8142
# naive, batched or keyset: which implementation answers GET /orders. A ?strategy= query parameter overrides it.
LISTING_STRATEGY=keyset
